# Copy to backend/.env and fill in. Everything has a working default except email.

# DATABASE_URL=sqlite:///./grievance.db
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/grievance   (Phase 3)

# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=1440

# Frontend (used for CORS and for links inside emails)
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Email via Gmail: Google Account > Security > 2-Step Verification > App passwords.
# Leave SMTP_USER empty to print emails in the API console instead of sending.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Demo helper: deliver EVERY email to this inbox (seeded users have fake addresses)
EMAIL_OVERRIDE_TO=

# Uploads
MAX_PHOTO_MB=5
MAX_VIDEO_MB=25
